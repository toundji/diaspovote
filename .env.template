# ============================================================
# DIASPOVOTE — .env.template
# Copier en .env et remplir toutes les valeurs.
# Ne JAMAIS committer le .env.
# ============================================================

# ── JWT ──────────────────────────────────────────────────────
# Générer : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_128_CHARS_HEX
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_128_CHARS_HEX
JWT_TOKEN_EXPIRES_IN=15m
JWT_TOKEN_EXPIRES_IN_ADMIN=8h

# ── AES-256-GCM (liens de reset password) ─────────────────────
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# EXACTEMENT 64 caractères hex
CRYPTO_KEY=CHANGE_ME_64_HEX_CHARS

# ── API Keys ─────────────────────────────────────────────────
# Une clé par app cliente — determine l'ApiClientType (voir shared/common.enum.ts).
# API_KEY_HEADER_NAME : nom du header HTTP dans lequel le client envoie sa clé
# (lu par core/middleware/api-middleware.ts ET whitelisté dans le CORS de main.ts —
# une seule variable pour les deux, ne pas la dupliquer sous un autre nom).
API_KEY_HEADER_NAME=diaspovote-key
API_KEY_MOBILE=
API_KEY_IOS=
API_KEY_WEB=
API_KEY_WEB_APP=
API_KEY_WEBSITE=
API_KEY_LANDING=
API_KEY_BACK_OFFICE=
API_KEY_SWAGGER=

# ── CORS ─────────────────────────────────────────────────────
# Domaines autorisés, séparés par des virgules (portail, back-office...).
# Avec credentials:true (cookies/Authorization), les navigateurs refusent '*' —
# cette variable DOIT être renseignée en production.
CORS_ORIGIN=https://vote.diaspovote.bj,https://admin.diaspovote.bj

# ── Reset Password ────────────────────────────────────────────
RESET_PASSWORD_ADDRESS=https://vote.diaspovote.bj/reset-password
RESET_PASSWORD_TOKEN=token

# ── Firebase (Google Sign-In + notifications push mobile) ────
# JSON complet du compte de service, sur UNE seule ligne (pas de fichier,
# pas de champs séparés) : Firebase Console → Paramètres → Comptes de service
# → Générer une nouvelle clé privée. Sans cette variable : Google Sign-In
# échoue et les notifications push restent désactivées (proprement, sans crash).
FIREBASE_SDK={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
FCM_ICON_URL=https://vote.diaspovote.bj/icon.png

# ── Serveur ───────────────────────────────────────────────────
NODE_ENV=development
API_ADDRESS=http://localhost:3000
API_PORT=3000
default_image_profile=http://localhost:3000/public/assets/default-avatar.jpg

# ── Base de données ───────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=CHANGE_ME
DB_NAME=diaspovote_db

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=

# ── Mail SMTP ─────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com        # ou smtp.sendgrid.net, smtp.mailgun.org
MAIL_PORT=587                   # 587 (TLS) ou 465 (SSL)
MAIL_SECURE=false               # true si port 465
MAIL_USER=your@email.com
MAIL_PASS=your-smtp-password
MAIL_FROM=noreply@diaspovote.bj

# ── App identity (utilisé dans les emails) ────────────────────
APP_NAME=DiaspoVote
APP_TAGLINE=La voix de la diaspora

# ── Seed (admin principal — npm run seed) ─────────────────────
# ⚠️ Compte le plus privilégié du système :
#   - JAMAIS une adresse jetable/publique (Mailinator et équivalents sont
#     lisibles par n'importe qui sans authentification).
#   - Mot de passe fort, pas une suite numérique.
SEED_ADMIN_EMAIL=CHANGE_ME@your-real-domain.tld
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=DiaspoVote
